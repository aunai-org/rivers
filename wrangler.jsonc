// Cloudflare Workers static assets: `npm run deploy` builds, then uploads dist/.
// public/_headers (copied into dist/) sets the CSP, which allows the Open-Meteo Flood API and nothing else outside.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rivers",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
