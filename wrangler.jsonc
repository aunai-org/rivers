// Cloudflare Workers: static files from dist/, plus a small Worker (worker/index.ts) that runs first for /api/* only.
// `npm run deploy` builds, then uploads both. public/_headers (copied into dist/) sets the CSP for the static files.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rivers",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
