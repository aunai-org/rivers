{"text":"<style>\n.riv{max-width:72rem;margin-inline:auto;font-family:var(--font-anthropic-sans);color:var(--color-fg)}\n.riv h1{font-family:var(--font-anthropic-serif);font-weight:400;font-size:var(--cds-font-size-title);margin:0 0 var(--cds-gap-xs)}\n.riv .take{color:var(--color-fg-muted);font-size:var(--cds-font-size-body);margin:0 0 var(--cds-gap-lg);max-width:46rem}\n.riv .take span{color:var(--color-fg);font-variant-numeric:tabular-nums}\n.riv .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,20rem),1fr));gap:var(--cds-gap-md);margin-bottom:var(--cds-gap-md)}\n.riv .card{background:var(--color-panel);border:1px solid var(--color-border-line);border-radius:var(--cds-radius);padding:var(--cds-pad-lg);min-width:0}\n.riv h2{font-size:var(--cds-font-size-heading);font-weight:var(--cds-font-weight-medium);margin:0}\n.riv .note{color:var(--color-fg-muted);font-size:var(--cds-font-size-caption);margin:2px 0 var(--cds-gap-sm)}\n.riv .head{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--cds-gap-md);flex-wrap:wrap}\n.riv .seg{display:inline-flex;border:1px solid var(--color-border-line);border-radius:var(--cds-radius);overflow:hidden}\n.riv .seg button{font:inherit;font-size:var(--cds-font-size-caption);padding:6px 12px;border:0;background:transparent;color:var(--color-fg-muted);cursor:pointer}\n.riv .seg button.on{background:var(--color-fg);color:var(--color-bg)}\n.riv .chart{position:relative;min-height:340px}\n.riv .ctl{display:flex;gap:var(--cds-gap-sm);flex-wrap:wrap}\n.riv .x{font:inherit;font-size:var(--cds-font-size-caption);padding:6px 12px;border:1px solid var(--color-border-line);border-radius:var(--cds-radius);background:transparent;color:var(--color-fg-muted);cursor:pointer}\n.riv .dbody{display:grid;grid-template-columns:minmax(10rem,18rem) 1fr;gap:var(--cds-gap-lg);align-items:start;margin-top:var(--cds-gap-sm)}\n@media (max-width:34rem){.riv .dbody{grid-template-columns:1fr}}\n.riv .clist{list-style:none;margin:0;padding:0;display:grid;gap:6px}\n.riv .clist li{display:flex;flex-direction:column;font-size:var(--cds-font-size-caption);padding:6px 8px;border:1px solid var(--color-border-line);border-radius:var(--cds-radius)}\n.riv .clist li.on{border-color:var(--color-fg)}\n.riv .clist span{color:var(--color-fg-muted)}\n.riv .rgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(9rem,1fr));gap:var(--cds-gap-sm)}\n.riv .rcard{font:inherit;text-align:left;display:flex;flex-direction:column;gap:2px;padding:var(--cds-pad-xs);border:1px solid var(--color-border-line);border-radius:var(--cds-radius);background:transparent;color:var(--color-fg);cursor:pointer}\n.riv .rcard.on{border-color:var(--color-fg)}\n.riv .rcard b{font-weight:var(--cds-font-weight-medium);font-size:var(--cds-font-size-caption)}\n.riv .rcard span,.riv .rcard i{font-style:normal;font-size:var(--cds-font-size-caption);color:var(--color-fg-muted)}\n.riv .chart svg{display:block}\n.riv .tip{position:absolute;pointer-events:none;background:var(--cds-surface-popover);border:1px solid var(--cds-border);border-radius:var(--cds-radius);box-shadow:var(--cds-shadow-popover);padding:var(--cds-pad-xs) var(--cds-pad-sm);font-size:var(--cds-font-size-caption);display:none;white-space:nowrap;z-index:2}\n.riv .tip b{font-weight:600}\n.riv .tip i{font-style:normal;color:var(--cds-text-secondary)}\n.riv .legend{display:flex;gap:var(--cds-gap-md);flex-wrap:wrap;font-size:var(--cds-font-size-caption);color:var(--color-fg-muted);margin-top:var(--cds-gap-sm)}\n.riv .legend s{display:inline-block;width:.6rem;height:.6rem;border-radius:50%;margin-right:.35rem;text-decoration:none}\n.riv .failed{display:flex;align-items:center;justify-content:center;gap:.4rem;min-height:340px;color:var(--color-fg-muted);font-size:var(--cds-font-size-caption)}\n.riv .failed::before{content:\"\";width:.375rem;height:.375rem;border-radius:50%;background:var(--color-bad)}\n.riv .tbox{max-height:26rem;overflow:auto}\n.riv table{width:100%;border-collapse:collapse;font-size:var(--cds-font-size-caption);font-variant-numeric:tabular-nums}\n.riv th{position:sticky;top:0;background:var(--color-panel);text-align:left;font-weight:var(--cds-font-weight-medium);color:var(--color-fg-muted);padding:6px 8px;cursor:pointer;white-space:nowrap;border-bottom:1px solid var(--color-border-line)}\n.riv td{padding:6px 8px;border-bottom:1px solid var(--cds-chart-grid)}\n.riv th.n,.riv td.n{text-align:right}\n.riv .bar{display:inline-block;height:.5rem;border-radius:4px;vertical-align:middle;margin-right:6px;background:var(--cds-chart-muted)}\n.riv .bar.up{background:var(--dash-c0)}\n@media (max-width:34rem){.riv .hide-s{display:none}}\n[data-dash-source-state=refreshing]{opacity:.5;transition:opacity var(--cds-dur-slow)}\n</style>\n<div class=\"riv\">\n  <h1>Countries inflated by their longest river</h1>\n  <p class=\"take\">Resize each country by the length of its longest river instead of its land area and <span data-source=\"top\" data-field=\"most\" data-row=\"0\">—</span> swells to <span data-source=\"top\" data-field=\"most_x\" data-row=\"0\">—</span> its fair share, while <span data-source=\"top\" data-field=\"least\" data-row=\"0\">—</span> shrinks to <span data-source=\"top\" data-field=\"least_x\" data-row=\"0\">—</span>.</p>\n  <div class=\"card\" style=\"margin-bottom:var(--cds-gap-md)\">\n    <div class=\"head\"><div><h2>The world, re-sized by river</h2><p class=\"note\">Each country’s area follows its longest river. Colour shows that river’s length.</p></div>\n      <div class=\"ctl\"><div class=\"seg\" role=\"group\" aria-label=\"Map view\"><button type=\"button\" data-mode=\"real\">Real size</button><button type=\"button\" data-mode=\"inflated\" class=\"on\">Inflated by river</button></div>\n      <div class=\"seg zoom\" role=\"group\" aria-label=\"Zoom\"><button type=\"button\" data-z=\"out\" aria-label=\"Zoom out\">−</button><button type=\"button\" data-z=\"in\" aria-label=\"Zoom in\">+</button><button type=\"button\" data-z=\"reset\">Reset</button></div></div>\n    <div class=\"chart\" id=\"c-map\" data-source=\"inflation\"><div class=\"dash-skeleton\" style=\"height:340px\"></div></div>\n    <div class=\"legend\" id=\"legend\"></div>\n  </div>\n  <div class=\"card\" id=\"detail\" style=\"margin-bottom:var(--cds-gap-md)\" hidden></div>\n  <div class=\"card\" style=\"margin-bottom:var(--cds-gap-md)\"><h2>Rivers behind the map</h2><p class=\"note\">Longest rivers, with an illustrative sketch of each.</p><div class=\"rgrid\" id=\"rivers\" data-source=\"inflation\"></div></div>\n  <div class=\"card\"><h2>Inflation by country</h2><p class=\"note\">Inflation = a country’s share of total river length ÷ its share of total land area.</p>\n    <div class=\"tbox\"><table id=\"tbl\" data-source=\"inflation\" data-row-key=\"country\"><thead><tr>\n      <th data-field=\"country\" data-k=\"country\">Country</th>\n      <th class=\"n\" data-field=\"area_km2\" data-k=\"area_km2\">Area km²</th>\n      <th class=\"hide-s\" data-field=\"river\" data-k=\"river\">River</th>\n      <th class=\"n\" data-field=\"river_km\" data-k=\"river_km\">River km</th>\n      <th class=\"n hide-s\" data-field=\"area_rank\" data-k=\"area_rank\">Area rank</th>\n      <th class=\"n hide-s\" data-field=\"river_rank\" data-k=\"river_rank\">River rank</th>\n      <th class=\"n\" data-field=\"inflation\" data-k=\"inflation\">Inflation</th>\n    </tr></thead><tbody></tbody></table></div>\n    <p class=\"note\" style=\"margin-top:var(--cds-gap-sm)\">Whole-river lengths; a shared river counts in full for each country it crosses. Figures are approximate.</p>\n  </div>\n</div>\n<script src=\"world.js\"></script>\n<script>\n(function(){\n  const page=document.querySelector('.riv');\n  page.style.setProperty('--dash-c0',dash.colors[0]);\n  dash.calc('inflation',{\n    title:'River inflation by country',\n    description:'Each country’s share of total river length divided by its share of total land area, plus ranks on each.',\n    inputs:['countries'],\n    fn:(countries)=>{\n      const rows=countries.map(r=>({country:r.country,area_km2:+r.area_km2,river:r.river,river_km:+r.river_km}));\n      const A=rows.reduce((s,r)=>s+r.area_km2,0),R=rows.reduce((s,r)=>s+r.river_km,0);\n      const byA=[...rows].sort((a,b)=>b.area_km2-a.area_km2).map(r=>r.country);\n      const byR=[...rows].sort((a,b)=>b.river_km-a.river_km).map(r=>r.country);\n      return rows.map(r=>({...r,area_rank:byA.indexOf(r.country)+1,river_rank:byR.indexOf(r.country)+1,inflation:(r.river_km/R)/(r.area_km2/A)}));\n    }});\n  dash.calc('top',{\n    title:'Biggest winner and loser',\n    description:'The country that gains the most and the one that shrinks the most.',\n    inputs:['inflation'],\n    fn:(inflation)=>{\n      const s=[...inflation].sort((a,b)=>b.inflation-a.inflation);\n      return [{most:s[0].country,most_x:s[0].inflation,least:s[s.length-1].country,least_x:s[s.length-1].inflation}];\n    }});\n\n  const fmt=d3.format(','),fx=d3.format('.1f');\n  const fmtX=v=>v>=10?d3.format(',.0f')(v)+'×':fx(v)+'×';\n  let sortK='inflation',sortDir=-1,cache=[];\n\n  function failed(el){el.innerHTML='';const d=document.createElement('div');d.className='failed';d.textContent='Failed to load';el.appendChild(d)}\n\n  const ALIAS={'United States':'United States of America','DR Congo':'Dem. Rep. Congo'};\n  const view={lon:15,lat:20,z:1,t:0};\n  let mode='inflated',played=false,rerender=null,geoCache=null,anim=0;\n  const ease=d3.easeElasticOut||d3.easeCubicOut;\n  const A1=1.340264,A2=-0.081106,A3=0.000893,A4=0.003796,RAD=Math.PI/180;\n  const BINS=[1000,2000,3500,5000],PCT=[22,40,60,80,100];\n  const BIN_LABELS=['under 1,000 km','1,000–2,000','2,000–3,500','3,500–5,000','5,000 km +'];\n  const binOf=km=>BINS.filter(b=>km>=b).length;\n  function eq(lon,lat){\n    const th=Math.asin(Math.sqrt(3)/2*Math.sin(lat*RAD)),t2=th*th,t6=t2*t2*t2;\n    return [2*Math.sqrt(3)*lon*RAD*Math.cos(th)/(3*(A1+3*A2*t2+t6*(7*A3+9*A4*t2))),th*(A1+A2*t2+t6*(A3+A4*t2))];\n  }\n  function invEq(x,y){\n    let th=y/A1;\n    for(let i=0;i<8;i++){const t2=th*th,t6=t2*t2*t2;th-=(th*(A1+A2*t2+t6*(A3+A4*t2))-y)/(A1+3*A2*t2+t6*(7*A3+9*A4*t2))}\n    th=Math.max(-Math.PI/3,Math.min(Math.PI/3,th));\n    const t2=th*th,t6=t2*t2*t2;\n    const lat=Math.asin(Math.max(-1,Math.min(1,2*Math.sin(th)/Math.sqrt(3))))/RAD;\n    const lon=3*x*(A1+3*A2*t2+t6*(7*A3+9*A4*t2))/(2*Math.sqrt(3)*Math.cos(th))/RAD;\n    return [Math.max(-180,Math.min(180,lon)),lat];\n  }\n  const polys=g=>g.type==='Polygon'?[g.coordinates]:g.coordinates;\n  const ringArea=pts=>{let a=0;for(let i=0;i<pts.length;i++){const p=pts[i],q=pts[(i+1)%pts.length];a+=p[0]*q[1]-q[0]*p[1]}return a/2};\n  // area of a region's rings (holes subtract) and the area-weighted centre of its outer rings\n  function stats(g){\n    let a=0,ao=0,cx=0,cy=0;\n    for(const r of g.rings){\n      const sa=ringArea(r.pts),aa=Math.abs(sa);a+=r.hole?-aa:aa;\n      if(r.hole||!sa)continue;\n      let sx=0,sy=0;\n      for(let i=0;i<r.pts.length;i++){const p=r.pts[i],q=r.pts[(i+1)%r.pts.length],cr=p[0]*q[1]-q[0]*p[1];sx+=(p[0]+q[0])*cr;sy+=(p[1]+q[1])*cr}\n      cx+=sx/(6*sa)*aa;cy+=sy/(6*sa)*aa;ao+=aa;\n    }\n    return {area:Math.max(a,1e-6),cx:ao?cx/ao:0,cy:ao?cy/ao:0};\n  }\n  // contiguous cartogram: every vertex is pushed by each region's size error until areas match g.want\n  function cartogram(regs,iters){\n    const R=regs.map(g=>({want:g.want,rings:g.rings.map(r=>({hole:r.hole,pts:r.pts.map(p=>[p[0],p[1]])}))}));\n    for(let it=0;it<iters;it++){\n      let T=0,D=0;\n      for(const g of R){Object.assign(g,stats(g));T+=g.area;D+=g.want}\n      let err=0;\n      for(const g of R){const d=g.want*T/D;g.rad=Math.sqrt(g.area/Math.PI);g.m=Math.sqrt(d/Math.PI)-g.rad;err+=Math.max(g.area,d)/Math.min(g.area,d)}\n      const red=1/(1+err/R.length),n=R.length;\n      const CX=new Float64Array(n),CY=new Float64Array(n),RD=new Float64Array(n),M=new Float64Array(n);\n      for(let i=0;i<n;i++){CX[i]=R[i].cx;CY[i]=R[i].cy;RD[i]=R[i].rad;M[i]=R[i].m}\n      for(const g of R)for(const r of g.rings)for(const p of r.pts){\n        let dx=0,dy=0;\n        for(let i=0;i<n;i++){\n          const ex=p[0]-CX[i],ey=p[1]-CY[i],dist=Math.sqrt(ex*ex+ey*ey)||1e-6,x=dist/RD[i];\n          const f=dist>RD[i]?M[i]/x:M[i]*x*x*(4-3*x);\n          dx+=f*ex/dist;dy+=f*ey/dist;\n        }\n        p[0]+=dx*red;p[1]+=dy*red;\n      }\n    }\n    return R;\n  }\n  // real and river-inflated longitude/latitude for every ring of every country\n  function prepare(rows){\n    const W0=1000,x180=eq(180,0)[0],ymax=eq(0,90)[1],sc=W0/(2*x180),h0=2*ymax*sc;\n    const P=(lon,lat)=>{const p=eq(lon,lat);return [W0/2+p[0]*sc,h0/2-p[1]*sc]};\n    const byName=new Map(rows.map(r=>[ALIAS[r.country]||r.country,r]));\n    const regs=Object.keys(window.WORLD).map(name=>{\n      const rings=[];\n      for(const pl of polys(window.WORLD[name]))pl.forEach((ring,i)=>rings.push({hole:i>0,ll:ring,pts:ring.map(c=>P(c[0],c[1]))}));\n      const g={name,row:byName.get(name),rings};g.area0=stats(g).area;return g;\n    });\n    const used=regs.filter(g=>g.row);\n    const lam=1.8*d3.sum(used,g=>g.area0)/d3.sum(used,g=>g.row.river_km);\n    for(const g of regs)g.want=g.row?g.row.river_km*lam:g.area0*0.35;\n    const out=cartogram(regs,14);\n    let x0=Infinity,y0=Infinity,x1=-Infinity,y1=-Infinity;\n    for(const g of out)for(const r of g.rings)for(const p of r.pts){x0=Math.min(x0,p[0]);x1=Math.max(x1,p[0]);y0=Math.min(y0,p[1]);y1=Math.max(y1,p[1])}\n    // fit the stretched map back onto the original frame, then read it as longitude/latitude\n    const back=p=>invEq(((p[0]-x0)/(x1-x0)*W0-W0/2)/sc,(h0/2-(p[1]-y0)/(y1-y0)*h0)/sc);\n    return regs.map((g,i)=>({\n      name:g.name,row:g.row,\n      rings:g.rings.map((r,j)=>({a:r.ll,b:out[i].rings[j].pts.map(back)}))\n    }));\n  }\n  // one ring on the globe, morphed by t (0 real, 1 inflated); hidden points are pinned to the horizon\n  function ringPath(ring,t,v,R,cx,cy){\n    const lam0=v.lon*RAD,sp=Math.sin(v.lat*RAD),cp=Math.cos(v.lat*RAD);\n    let d='',vis=0;\n    for(let i=0;i<ring.a.length;i++){\n      const A=ring.a[i],B=ring.b[i];\n      let lat=A[1]+(B[1]-A[1])*t;\n      lat=Math.max(-89.9,Math.min(89.9,lat));\n      const l=(A[0]+(B[0]-A[0])*t)*RAD-lam0,f=lat*RAD,cf=Math.cos(f),cl=Math.cos(l);\n      let x=cf*Math.sin(l),y=cp*Math.sin(f)-sp*cf*cl;\n      if(sp*Math.sin(f)+cp*cf*cl>0)vis++;\n      else{const m=Math.hypot(x,y)||1;x/=m;y/=m}\n      d+=(i?'L':'M')+(cx+R*x).toFixed(1)+','+(cy-R*y).toFixed(1);\n    }\n    return vis?d+'Z':'';\n  }\n  function gratPath(v,R,cx,cy){\n    const lam0=v.lon*RAD,sp=Math.sin(v.lat*RAD),cp=Math.cos(v.lat*RAD);\n    let d='';\n    const run=pts=>{\n      let pen=false;\n      for(const c of pts){\n        const l=c[0]*RAD-lam0,f=c[1]*RAD,cf=Math.cos(f),cl=Math.cos(l);\n        if(sp*Math.sin(f)+cp*cf*cl<=0){pen=false;continue}\n        d+=(pen?'L':'M')+(cx+R*cf*Math.sin(l)).toFixed(1)+','+(cy-R*(cp*Math.sin(f)-sp*cf*cl)).toFixed(1);pen=true;\n      }\n    };\n    for(let lo=-180;lo<180;lo+=30){const pts=[];for(let la=-90;la<=90;la+=5)pts.push([lo,la]);run(pts)}\n    for(let la=-60;la<=60;la+=30){const pts=[];for(let lo=-180;lo<=180;lo+=5)pts.push([lo,la]);run(pts)}\n    return d;\n  }\n  const fillOf=s=>s.row?'color-mix(in srgb, '+dash.colors[0]+' '+PCT[binOf(s.row.river_km)]+'%, var(--cds-chart-grid))':'var(--cds-chart-grid)';\n\n  function map(el,rows){\n    el.innerHTML='';\n    if(!geoCache||geoCache.key!==rows.length)geoCache={key:rows.length,items:prepare(rows)};\n    const items=geoCache.items;\n    const w=Math.max(280,el.clientWidth),h=Math.min(560,Math.round(w*0.78)),cx=w/2,cy=h/2,base=h/2*0.92;\n    const tip=document.createElement('div');tip.className='tip';\n    const svg=d3.select(el).append('svg').attr('width','100%').attr('viewBox','0 0 '+w+' '+h)\n      .style('touch-action','none').style('cursor','grab').style('display','block');\n    const ocean=svg.append('circle').attr('cx',cx).attr('cy',cy).style('fill','var(--color-bg)').style('stroke','var(--cds-chart-axis)').style('stroke-width',1);\n    const grat=svg.append('path').style('fill','none').style('stroke','var(--cds-chart-grid)').style('stroke-width',.6);\n    const paths=svg.append('g').selectAll('path').data(items).join('path')\n      .style('stroke-linejoin','round').style('fill',fillOf)\n      .style('stroke','var(--color-bg)').style('stroke-width',.6).attr('vector-effect','non-scaling-stroke');\n    function render(){\n      const R=base*view.z;\n      ocean.attr('r',R);\n      grat.attr('d',gratPath(view,R,cx,cy));\n      paths.attr('d',s=>s.rings.map(r=>ringPath(r,view.t,view,R,cx,cy)).join(''));\n    }\n    rerender=render;render();\n    paths.on('mousemove',function(ev,s){\n      if(dragging)return;\n      const b=el.getBoundingClientRect();\n      d3.select(this).style('stroke','var(--color-fg)').style('stroke-width',1.5);\n      tip.innerHTML='';\n      const t=document.createElement('b');t.textContent=s.row?s.row.country:s.name;tip.appendChild(t);\n      if(s.row){\n        const r=s.row;\n        const l1=document.createElement('div');const i1=document.createElement('i');i1.textContent=fmt(r.area_km2)+' km² land';l1.appendChild(i1);\n        const l2=document.createElement('div');const i2=document.createElement('i');i2.textContent=r.river+', '+fmt(r.river_km)+' km';l2.appendChild(i2);\n        const l3=document.createElement('div');l3.textContent=fmtX(r.inflation)+' its land share';\n        tip.append(l1,l2,l3);\n      }\n      tip.style.display='block';\n      const x=Math.min(ev.clientX-b.left+12,Math.max(0,b.width-tip.offsetWidth-4));\n      tip.style.left=x+'px';tip.style.top=Math.max(0,ev.clientY-b.top-tip.offsetHeight-8)+'px';\n    }).on('mouseleave',()=>{paintSel();tip.style.display='none'})\n      .on('click',(ev,s)=>{if(moved<5&&s.row)pick(s.row.river,s.row.country)});\n    let dragging=false,lx=0,ly=0,pending=false,moved=0;\n    const queue=()=>{if(pending)return;pending=true;requestAnimationFrame(()=>{pending=false;render()})};\n    svg.on('pointerdown',ev=>{dragging=true;moved=0;lx=ev.clientX;ly=ev.clientY;svg.style('cursor','grabbing')})\n      .on('pointermove',ev=>{\n        if(!dragging)return;\n        const k=0.4/view.z;\n        moved+=Math.abs(ev.clientX-lx)+Math.abs(ev.clientY-ly);\n        if(moved>=5)tip.style.display='none';\n        view.lon-=(ev.clientX-lx)*k;view.lat=Math.max(-85,Math.min(85,view.lat+(ev.clientY-ly)*k));\n        view.lon=((view.lon+540)%360)-180;\n        lx=ev.clientX;ly=ev.clientY;queue();\n      })\n      .on('pointerup pointercancel pointerleave',()=>{dragging=false;svg.style('cursor','grab')});\n    paintSel=()=>{\n      const hit=s=>sel.river&&s.row&&s.row.river===sel.river;\n      paths.style('stroke',s=>hit(s)?'var(--color-fg)':'var(--color-bg)').style('stroke-width',s=>hit(s)?2:.6);\n    };\n    paintSel();\n    el.appendChild(tip);\n    if(!played){played=true;inflate(true)}\n  }\n\n  // morph between the real and the inflated shapes; the elastic ease makes it overshoot like a balloon\n  function inflate(on){\n    cancelAnimationFrame(anim);\n    const from=view.t,to=on?1:0,t0=performance.now(),dur=on?2400:900;\n    const step=now=>{\n      const u=Math.min(1,(now-t0)/dur);\n      view.t=from+(to-from)*(on?ease(u):d3.easeCubicInOut(u));\n      if(rerender)rerender();\n      if(u<1)anim=requestAnimationFrame(step);\n    };\n    anim=requestAnimationFrame(step);\n  }\n\n  document.querySelectorAll('.seg:not(.zoom) button').forEach(b=>b.addEventListener('click',()=>{\n    mode=b.dataset.mode;\n    document.querySelectorAll('.seg:not(.zoom) button').forEach(x=>x.classList.toggle('on',x===b));\n    inflate(mode==='inflated');\n  }));\n  document.querySelectorAll('.zoom button').forEach(b=>b.addEventListener('click',()=>{\n    const a=b.dataset.z;\n    if(a==='reset'){view.z=1;view.lon=15;view.lat=20}\n    else view.z=Math.max(1,Math.min(8,view.z*(a==='in'?1.5:1/1.5)));\n    if(rerender)rerender();\n  }));\n  (function legend(){\n    const lg=document.getElementById('legend');\n    const add=(bg,text)=>{const s=document.createElement('span'),i=document.createElement('s');i.style.background=bg;s.append(i,document.createTextNode(text));lg.appendChild(s)};\n    const lab=document.createElement('span');lab.textContent='Longest river:';lg.appendChild(lab);\n    BIN_LABELS.forEach((t,i)=>add('color-mix(in srgb, '+dash.colors[0]+' '+PCT[i]+'%, var(--cds-chart-grid))',t));\n    add('var(--cds-chart-grid)','not in table');\n  })();\n\n  // click selection: a river (and the country that was clicked) lights up on the globe and opens a detail card\n  const sel={river:null,country:null};\n  let paintSel=null;\n  function seeded(str){let h=2166136261;for(const ch of str){h^=ch.charCodeAt(0);h=Math.imul(h,16777619)}return ()=>{h=Math.imul(h^(h>>>15),2246822507);h=Math.imul(h^(h>>>13),3266489909);h^=h>>>16;return (h>>>0)/4294967296}}\n  // a small drawn sketch of a river: meander, tributaries, banks. Illustration only, not a real course.\n  function riverArt(name,km){\n    const wd=160,ht=90,rnd=seeded(name),NS='http://www.w3.org/2000/svg';\n    const svg=document.createElementNS(NS,'svg');\n    svg.setAttribute('viewBox','0 0 '+wd+' '+ht);svg.setAttribute('width','100%');svg.setAttribute('role','img');svg.setAttribute('aria-label','Sketch of the '+name);\n    const mk=(tag,attrs)=>{const e=document.createElementNS(NS,tag);for(const k in attrs)e.setAttribute(k,attrs[k]);svg.appendChild(e);return e};\n    mk('rect',{width:wd,height:ht,rx:6,style:'fill:color-mix(in srgb, '+dash.colors[0]+' 10%, var(--color-panel))'});\n    const amp=8+rnd()*14,fr=0.05+rnd()*0.06,ph=rnd()*6.28,y0=ht*(0.4+rnd()*0.2);\n    const pts=[];for(let x=-4;x<=wd+4;x+=6)pts.push([x,y0+amp*Math.sin(x*fr+ph)+4*Math.sin(x*fr*3.1+ph*2)]);\n    const ln=d3.line().curve(d3.curveBasis),width=1.5+Math.min(4,Math.log10(km)*1.2);\n    for(let i=0;i<3;i++){\n      const k=Math.floor(6+rnd()*(pts.length-12)),p=pts[k],up=rnd()<.5?-1:1;\n      const tr=[[p[0],p[1]],[p[0]-8-rnd()*8,p[1]+up*(10+rnd()*8)],[p[0]-14-rnd()*10,p[1]+up*(24+rnd()*10)]];\n      mk('path',{d:ln(tr),style:'fill:none;stroke:'+dash.colors[0]+';stroke-width:'+(width*0.5)+';stroke-linecap:round;opacity:.6'});\n    }\n    mk('path',{d:ln(pts),style:'fill:none;stroke:'+dash.colors[0]+';stroke-width:'+width+';stroke-linecap:round;stroke-linejoin:round'});\n    return svg;\n  }\n  const byRiver=rows=>{\n    const m=new Map();\n    for(const r of rows){if(!m.has(r.river))m.set(r.river,{river:r.river,km:r.river_km,rows:[]});m.get(r.river).rows.push(r)}\n    return [...m.values()].sort((a,b)=>b.km-a.km);\n  };\n  function pick(river,country){\n    sel.river=river;sel.country=country;\n    if(paintSel)paintSel();\n    showDetail();\n  }\n  function showDetail(){\n    const box=document.getElementById('detail');\n    box.innerHTML='';\n    const g=sel.river&&byRiver(cache).find(x=>x.river===sel.river);\n    if(!g){box.hidden=true;return}\n    box.hidden=false;\n    const head=document.createElement('div');head.className='head';\n    const hd=document.createElement('div');\n    const h2=document.createElement('h2');h2.textContent=g.river;\n    const nt=document.createElement('p');nt.className='note';nt.textContent=fmt(g.km)+' km long';\n    hd.append(h2,nt);\n    const close=document.createElement('button');close.type='button';close.className='x';close.textContent='Close';\n    close.addEventListener('click',()=>pick(null,null));\n    head.append(hd,close);\n    const body=document.createElement('div');body.className='dbody';\n    const art=document.createElement('div');art.className='art';art.appendChild(riverArt(g.river,g.km));\n    const list=document.createElement('div');\n    const lt=document.createElement('p');lt.className='note';lt.textContent='Flows through (countries in this table)';\n    const ul=document.createElement('ul');ul.className='clist';\n    for(const r of g.rows){\n      const li=document.createElement('li');if(r.country===sel.country)li.className='on';\n      const a=document.createElement('b');a.textContent=r.country;\n      const b=document.createElement('span');b.textContent=fmt(r.area_km2)+' km² land · river is '+fmtX(r.inflation)+' its land share';\n      li.append(a,b);ul.appendChild(li);\n    }\n    list.append(lt,ul);\n    body.append(art,list);\n    box.append(head,body);\n  }\n  function gallery(rows){\n    const el=document.getElementById('rivers');el.innerHTML='';\n    for(const g of byRiver(rows)){\n      const card=document.createElement('button');card.type='button';card.className='rcard'+(g.river===sel.river?' on':'');\n      const nm=document.createElement('b');nm.textContent=g.river;\n      const km=document.createElement('span');km.textContent=fmt(g.km)+' km';\n      const cs=document.createElement('i');cs.textContent=g.rows.map(r=>r.country).join(', ');\n      card.append(riverArt(g.river,g.km),nm,km,cs);\n      card.addEventListener('click',()=>pick(g.river,null));\n      el.appendChild(card);\n    }\n  }\n\n  function table(){\n    const tb=document.querySelector('#tbl tbody');tb.innerHTML='';\n    const rows=[...cache].sort((a,b)=>{const x=a[sortK],y=b[sortK];return (typeof x==='number'?x-y:String(x).localeCompare(String(y)))*sortDir});\n    const mx=d3.max(cache,r=>r.inflation)||1;\n    document.querySelectorAll('#tbl th').forEach(th=>th.setAttribute('aria-sort',th.dataset.k===sortK?(sortDir>0?'ascending':'descending'):'none'));\n    for(const r of rows){\n      const tr=document.createElement('tr');tr.dataset.key=r.country;\n      const cells=[[r.country,''],[fmt(r.area_km2),'n'],[r.river,'hide-s'],[fmt(r.river_km),'n'],[r.area_rank,'n hide-s'],[r.river_rank,'n hide-s']];\n      for(const c of cells){const td=document.createElement('td');td.className=c[1];td.textContent=c[0];tr.appendChild(td)}\n      const td=document.createElement('td');td.className='n';\n      const bar=document.createElement('span');bar.className='bar'+(r.inflation>1?' up':'');\n      bar.style.width=Math.max(2,Math.sqrt(r.inflation/mx)*60)+'px';\n      td.append(bar,document.createTextNode(fmtX(r.inflation)));tr.appendChild(td);tb.appendChild(tr);\n    }\n  }\n\n  document.querySelectorAll('#tbl th').forEach(th=>th.addEventListener('click',()=>{\n    const k=th.dataset.k;if(k===sortK)sortDir=-sortDir;else{sortK=k;sortDir=(k==='country'||k==='river')?1:-1}\n    table();\n  }));\n\n  dash.onData(()=>{\n    const d=dash.data('inflation'),a=document.getElementById('c-map');\n    if(d.status==='error'||d.status==='connect'||d.status==='missing'){failed(a);return}\n    if(d.status!=='ok'||!d.data.length){return}\n    cache=d.data;\n    map(a,cache);table();gallery(cache);showDetail();\n  });\n})();\n</script>\n"}